---
import Logo from '../components/Logo.astro';
import '../styles/global.css';

const title = 'Tanjung Emas Muar — Panduan Taman Tepi Sungai di Johor';
const description = 'Panduan bebas ke Tanjung Emas Muar: waktu terbaik, akses, parkir, pengangkutan, makanan Muar, tempat berdekatan, peta dan FAQ.';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/images/tanjung-emas-estuary.webp', Astro.site).href : undefined;

const mapPageUrl = 'https://www.google.com/maps/search/?api=1&query=Tanjung%20Emas%20Muar%2C%20Taman%20Sri%20Tanjung%2C%2084000%20Muar%2C%20Johor%2C%20Malaysia';
const bmjUrl = 'https://paj.com.my/bmj-route-schedules-muar/';
const officialUrl = 'https://www.mpmuar.gov.my/rakyat/destinasi-menarik/sukan-rekreasi';
const commonsUrl = 'https://commons.wikimedia.org/wiki/Category:Tanjung_Emas,_Muar';

const dayOfWeek = [
  'https://schema.org/Monday',
  'https://schema.org/Tuesday',
  'https://schema.org/Wednesday',
  'https://schema.org/Thursday',
  'https://schema.org/Friday',
  'https://schema.org/Saturday',
  'https://schema.org/Sunday',
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Tanjung Emas Muar',
  alternateName: ['Taman Tanjung Emas', 'Dataran Tanjung Emas'],
  description,
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Taman Sri Tanjung',
    postalCode: '84000',
    addressLocality: 'Muar',
    addressRegion: 'Johor',
    addressCountry: 'MY',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 2.0467656479262546,
    longitude: 102.55007006212864,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek,
      opens: '06:00',
      closes: '09:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek,
      opens: '15:00',
      closes: '19:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.4',
    bestRating: '5',
  },
  priceRange: 'Akses taman: percuma; aktiviti operator berasingan',
  isAccessibleForFree: true,
};

const faqs = [
  {
    q: 'Adakah Tanjung Emas Muar mengenakan tiket masuk?',
    a: 'Kawasan taman awam lazimnya boleh dimasuki tanpa tiket. Aktiviti beroperasi berasingan seperti pelayaran Sungai Muar mungkin mengenakan caj dan jadualnya boleh berubah.',
  },
  {
    q: 'Bilakah waktu terbaik untuk datang?',
    a: 'Awal pagi sesuai untuk berjalan dan berjoging, manakala lewat petang hingga matahari terbenam memberi suasana tepi sungai yang paling menarik. Hujung minggu biasanya lebih meriah dan lebih sesak.',
  },
  {
    q: 'Berapa lama patut diperuntukkan?',
    a: 'Sekitar satu hingga dua jam sesuai untuk berjalan santai, mengambil gambar dan menikmati tepi sungai. Tambah masa jika anda mahu menaiki pelayaran sungai atau makan di bandar Muar.',
  },
  {
    q: 'Ada tempat letak kereta?',
    a: 'Terdapat pilihan parkir awam di sekitar Taman Sri Tanjung. Jenis parkir, caj dan sekatan boleh berbeza mengikut lokasi, jadi ikut papan tanda tempatan dan datang lebih awal pada waktu puncak.',
  },
  {
    q: 'Boleh datang dengan bas?',
    a: 'Boleh. Terminal Bentayan ialah terminal bas ekspres utama Muar. Dalam bandar, semak laluan terkini Bas Muafakat Johor (BMJ), kemudian gunakan teksi atau e-hailing untuk perjalanan akhir jika laluan tidak berhenti berhampiran taman.',
  },
  {
    q: 'Lapangan terbang mana yang paling praktikal?',
    a: 'Lapangan Terbang Antarabangsa Melaka lebih dekat secara geografi, tetapi kekerapan penerbangan boleh berubah. KLIA menawarkan rangkaian penerbangan jauh lebih luas; dari sana sambung melalui jalan raya atau bas ekspres ke Muar jika tersedia.',
  },
  {
    q: 'Adakah pelayaran Sungai Muar beroperasi setiap hari?',
    a: 'Majlis Perbandaran Muar menyenaraikan perkhidmatan bot dari kawasan Tanjung Emas, tetapi jadual sebenar bergantung pada operator, hari dan keadaan operasi. Semak terus di jeti sebelum merancang perjalanan khusus untuk aktiviti ini.',
  },
  {
    q: 'Apa makanan Muar yang sesuai dicuba selepas melawat?',
    a: 'Antara pilihan yang sinonim dengan lawatan ke Muar ialah mee bandung, otak-otak, asam pedas dan satay. Cari gerai atau kedai di sekitar Bandar Maharani dan Taman Sri Tanjung, kemudian semak waktu operasi semasa sebelum pergi.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: a,
    },
  })),
};
---
<!doctype html>
<html lang="ms-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E2E3B" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="geo.region" content="MY-01" />
    <meta name="geo.placename" content="Muar" />
    <meta name="geo.position" content="2.0467656479262546;102.55007006212864" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body id="atas">
    <header class="site-header">
      <div class="shell header-row">
        <Logo light />
        <nav class="nav" aria-label="Navigasi utama">
          <a href="#rancang">Rancang</a>
          <a href="#pengangkutan">Pengangkutan</a>
          <a href="#makan">Makan</a>
          <a href="#sekitar">Sekitar</a>
          <a href="#faq">FAQ</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-media">
          <img src="/images/tanjung-emas-estuary.webp" alt="Pemandangan muara Sungai Muar dari Tanjung Emas" width="2200" height="955" fetchpriority="high" />
        </div>
        <div class="hero-content">
          <div class="shell hero-grid">
            <div>
              <div class="hero-place">
                <span class="pill"><i></i> Bandar Maharani, Muar</span>
                <span class="pill">Tepi Sungai · Rekreasi · Senja</span>
              </div>
              <h1 id="hero-title" class="display">Di hujung Sungai Muar, kota bergerak lebih perlahan.</h1>
              <p class="hero-sub">Tanjung Emas ialah ruang rekreasi di muara Sungai Muar — tempat untuk berjalan di tepi air, melihat senja, bersantai bersama keluarga dan memulakan pelayaran sungai apabila perkhidmatan beroperasi.</p>
              <div class="hero-actions">
                <a class="btn btn--gold" href="#rancang">
                  Rancang lawatan
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <a class="btn btn--ghost" href={mapPageUrl} target="_blank" rel="noopener noreferrer">
                  Buka Google Maps
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s6-5 6-11a6 6 0 1 0-12 0c0 6 6 11 6 11Z" /><circle cx="12" cy="10" r="2" /></svg>
                </a>
              </div>
            </div>
            <aside class="hero-note" aria-label="Ringkasan penilaian">
              <div class="score"><strong>4.4</strong><span>/ 5</span></div>
              <p>Penilaian agregat Google yang dipaparkan oleh sumber perjalanan, daripada lebih 11 ribu ulasan. Skor boleh berubah apabila ulasan baharu masuk.</p>
            </aside>
          </div>
        </div>
        <div class="hero-wave" aria-hidden="true">
          <svg viewBox="0 0 1440 52" preserveAspectRatio="none"><path d="M0 26C236 50 345 2 594 20c258 19 361 34 573 7 117-15 200-13 273-4v29H0Z" fill="#FBFAF3" /></svg>
        </div>
      </section>

      <section class="quick-strip" aria-label="Maklumat cepat">
        <div class="shell quick-grid">
          <div class="quick-item"><b>Masuk</b><span>Taman awam · tiada tiket biasa</span></div>
          <div class="quick-item"><b>Masa terbaik</b><span>Awal pagi / lewat petang</span></div>
          <div class="quick-item"><b>Cadangan tempoh</b><span>1–2 jam santai</span></div>
          <div class="quick-item"><b>Lokasi</b><span>Taman Sri Tanjung, Muar</span></div>
        </div>
      </section>

      <section class="section" id="tentang">
        <div class="shell story-grid">
          <div class="story-copy">
            <span class="section-kicker">Kenapa Tanjung Emas</span>
            <h2 class="heading">Taman bandar dengan wajah Sungai Muar.</h2>
            <p class="lead">Majlis Perbandaran Muar menerangkan Tanjung Emas sebagai taman rekreasi di muara Sungai Muar, dengan laluan tepi sungai, pemandangan air, padang golf 9 lubang dan perkhidmatan bot yang berlepas dari kawasan taman.</p>
          </div>
          <div class="story-list">
            <article class="story-card">
              <div class="num">01</div>
              <h3>Promenad di tepi muara</h3>
              <p>Laluan berturap mengikuti garis air dan sesuai untuk berjalan santai atau berjoging sambil melihat Sungai Muar menuju Selat Melaka.</p>
            </article>
            <article class="story-card">
              <div class="num">02</div>
              <h3>Suasana berubah mengikut waktu</h3>
              <p>Pagi lebih tenang dan praktikal untuk bersenam. Lewat petang membawa cahaya senja, angin tepi sungai dan suasana keluarga yang lebih meriah.</p>
            </article>
            <article class="story-card">
              <div class="num">03</div>
              <h3>Pintu masuk kepada Muar dari sungai</h3>
              <p>Apabila operator beroperasi, pelayaran Sungai Muar memberi perspektif bandar yang berbeza. Jadual, tempoh dan caj hendaklah disahkan terus di jeti.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section photo-band" aria-labelledby="galeri-title">
        <div class="shell">
          <div class="photo-intro">
            <div>
              <span class="section-kicker" style="color:#E8AC54">Wajah sebenar lokasi</span>
              <h2 id="galeri-title" class="heading">Air, langit, dan laluan yang panjang.</h2>
            </div>
            <p>Semua foto di bawah ialah foto sebenar Tanjung Emas, dirakam oleh Slleong dan diterbitkan melalui Wikimedia Commons di bawah dedikasi CC0.</p>
          </div>
          <div class="photo-layout">
            <figure class="photo-main">
              <img src="/images/tanjung-emas-promenade.webp" alt="Promenad merah di sepanjang tebing Sungai Muar di Tanjung Emas" loading="lazy" width="2200" height="1650" />
              <figcaption>Promenad Tanjung Emas · Foto Slleong / Wikimedia Commons · CC0</figcaption>
            </figure>
            <div class="photo-stack">
              <figure>
                <img src="/images/tanjung-emas-sunset-point.webp" alt="Pemandangan sungai dari kawasan Sunset Point Tanjung Emas" loading="lazy" width="2200" height="1650" />
                <figcaption>Sunset Point · Foto Slleong / Wikimedia Commons · CC0</figcaption>
              </figure>
              <figure>
                <img src="/images/tanjung-emas-shore.webp" alt="Tebing berbatu dan air di Tanjung Emas Muar" loading="lazy" width="2200" height="1650" />
                <figcaption>Tebing muara · Foto Slleong / Wikimedia Commons · CC0</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="rancang">
        <div class="shell">
          <span class="section-kicker">Rancang lawatan</span>
          <h2 class="heading">Perkara penting sebelum bergerak.</h2>
          <p class="lead">Tanjung Emas ialah ruang awam, jadi pengalaman sebenar banyak dipengaruhi cuaca, hujung minggu dan operasi vendor. Gunakan maklumat ini sebagai asas, kemudian semak peta pada hari lawatan.</p>

          <div class="info-board">
            <article class="info-card info-card--wide">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
              <h3>Waktu & waktu terbaik</h3>
              <p>Rujukan perjalanan semasa menunjukkan dua slot harian, <strong>6:00–9:00 pagi</strong> dan <strong>3:00–7:00 petang</strong>. Untuk pengalaman, pilih awal pagi atau lewat petang hingga senja.</p>
              <div class="callout">Waktu ruang awam, aktiviti, jeti, gerai dan akses kenderaan boleh berbeza. Semak Google Maps / maklumat operator sebelum bertolak.</div>
            </article>

            <article class="info-card info-card--narrow">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16l-2 11H6L4 7Z"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg></div>
              <h3>Tiket / kos</h3>
              <p>Akses biasa ke taman awam tidak memerlukan tiket. Aktiviti berasingan seperti pelayaran sungai, permainan atau vendor mungkin berbayar.</p>
              <ul>
                <li>Elakkan bergantung pada harga lama dari ulasan.</li>
                <li>Semak caj operator terus pada hari lawatan.</li>
              </ul>
            </article>

            <article class="info-card info-card--half">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 17V8l2-3h10l2 3v9"/><path d="M3 17h18M7 17v2M17 17v2"/><circle cx="8" cy="12" r="1"/><circle cx="16" cy="12" r="1"/></svg></div>
              <h3>Parkir</h3>
              <p>Parkir awam tersedia di sekitar Taman Sri Tanjung dan kawasan berdekatan. Sumber direktori tempatan menunjukkan gabungan pilihan percuma, berbayar dan parkir tepi jalan.</p>
              <div class="callout">Pada hujung minggu / lewat petang, datang lebih awal dan ikut papan tanda. Jangan anggap kawasan bersebelahan sebagai parkir rasmi tanpa kebenaran.</div>
            </article>

            <article class="info-card info-card--half">
              <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19c4-8 12-8 16 0"/><circle cx="12" cy="7" r="3"/><path d="M3 12h3M18 12h3"/></svg></div>
              <h3>Cadangan tempoh</h3>
              <p><strong>1–2 jam</strong> mencukupi untuk promenad, gambar dan waktu santai. Jika anda mahu pelayaran sungai atau makan di pusat bandar, jadikan Tanjung Emas sebahagian daripada separuh hari di Muar.</p>
              <ul>
                <li>Pagi: berjalan / berjoging dan suasana lebih ringan.</li>
                <li>Petang: senja, keluarga dan suasana lebih hidup.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section route-section" id="pengangkutan">
        <div class="shell route-grid">
          <div class="route-sticky">
            <span class="section-kicker">Pengangkutan terperinci</span>
            <h2 class="heading">Sampai ke tepi Sungai Muar tanpa meneka.</h2>
            <p class="lead">Titik akhir untuk navigasi ialah “Tanjung Emas Muar / Taman Sri Tanjung”. Bagi pengangkutan awam, rancang perjalanan hingga Muar dahulu, kemudian perjalanan akhir yang pendek melalui teksi atau e-hailing.</p>
            <p><a class="btn btn--gold" href={mapPageUrl} target="_blank" rel="noopener noreferrer">Arah di Google Maps</a></p>
          </div>

          <div class="route-stack">
            <article class="route-card">
              <div>
                <h3>Dari lapangan terbang</h3>
                <p><strong>Melaka International Airport</strong> ialah pilihan serantau yang lebih dekat secara geografi; semak dahulu sama ada penerbangan sesuai tersedia. Untuk rangkaian penerbangan antarabangsa yang lebih luas, <strong>KLIA</strong> biasanya lebih praktikal. Dari KLIA, gunakan kereta / teksi jarak jauh atau bas ekspres ke Muar jika jadual tersedia, kemudian sambung ke Tanjung Emas.</p>
              </div>
            </article>
            <article class="route-card">
              <div>
                <h3>Bas ekspres ke Muar</h3>
                <p><strong>Terminal Bentayan Muar</strong> ialah terminal bas ekspres utama bandar. Selepas tiba, sambung dengan teksi / e-hailing. Jadual bas antara bandar berubah mengikut operator, jadi tempah berdasarkan tarikh perjalanan sebenar.</p>
              </div>
            </article>
            <article class="route-card">
              <div>
                <h3>Bas awam dalam daerah</h3>
                <p>Perbadanan Pengangkutan Awam Johor (PAJ) menerbitkan laluan dan jadual <strong>Bas Muafakat Johor (BMJ) untuk Muar</strong>. Semak peta laluan terkini; jika hentian tidak berhampiran taman, gunakan sambungan teksi / e-hailing untuk bahagian akhir. <a href={bmjUrl} target="_blank" rel="noopener noreferrer">Semak BMJ ↗</a></p>
              </div>
            </article>
            <article class="route-card">
              <div>
                <h3>Teksi & e-hailing</h3>
                <p>Ini cara paling mudah untuk perjalanan akhir dari pusat Bandar Maharani atau Terminal Bentayan. Masukkan “Tanjung Emas Muar” sebagai destinasi dan sahkan titik turun berhampiran promenad / pintu masuk yang aktif.</p>
              </div>
            </article>
            <article class="route-card">
              <div>
                <h3>Memandu sendiri</h3>
                <p>Ikut navigasi ke <strong>Taman Sri Tanjung, 84000 Muar</strong>. Bila menghampiri kawasan, perlahankan kenderaan dan ikut papan tanda parkir serta sebarang sekatan akses yang sedang berkuat kuasa.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="peta">
        <div class="shell">
          <div class="map-head">
            <div>
              <span class="section-kicker">Peta lokasi</span>
              <h2 class="heading">Tanjung Emas, Muar.</h2>
            </div>
            <p>Peta Google diset kepada bahasa Melayu / rantau Malaysia. Gunakan peta interaktif untuk pintu masuk, keadaan jalan dan pilihan parkir terkini.</p>
          </div>
          <div class="map-wrap">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3987.2728507495603!2d102.55007006212864!3d2.0467656479262546!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31d1b91834e77bd1%3A0xda0ddcf00e68d957!2sTanjung%20Emas%20Muar!5e0!3m2!1sms!2smy!4v1786539993997!5m2!1sms!2smy"
              width="600"
              height="450"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Peta Google Tanjung Emas Muar"
            ></iframe>
          </div>
        </div>
      </section>

      <section class="section food-section" id="makan">
        <div class="shell">
          <span class="section-kicker">Makanan sekitar</span>
          <h2 class="heading">Lepas tepi sungai, makan cara Muar.</h2>
          <p class="lead">Daripada mengejar satu kedai tertentu, gunakan empat hidangan ini sebagai kompas. Cari pilihan di sekitar Taman Sri Tanjung, Bandar Maharani dan pusat Muar, kemudian semak waktu operasi semasa.</p>
          <div class="food-grid">
            <article class="food-card"><span class="food-no">01</span><div><h3>Mee Bandung Muar</h3><p>Mi dengan kuah pekat berempah yang menjadi antara rasa paling dikenali apabila orang bercakap tentang Muar.</p></div></article>
            <article class="food-card"><span class="food-no">02</span><div><h3>Otak-otak</h3><p>Snek ikan berempah yang mudah dibawa dan sangat serasi dengan persinggahan santai selepas berjalan di tepi sungai.</p></div></article>
            <article class="food-card"><span class="food-no">03</span><div><h3>Asam pedas</h3><p>Pilihan makan tengah hari atau malam untuk rasa masam-pedas berkuah, lazimnya dipadankan dengan ikan dan nasi.</p></div></article>
            <article class="food-card"><span class="food-no">04</span><div><h3>Satay Muar</h3><p>Sesuai sebagai sarapan lewat atau makan ringan, bergantung pada kedai dan waktu operasi yang anda pilih.</p></div></article>
          </div>
          <div class="food-spots" aria-label="Cadangan tempat makan sekitar Tanjung Emas">
            <a class="food-spot" href="https://www.google.com/maps/search/?api=1&query=Pak%20Cik%20Kopitiam%20Sri%20Muar" target="_blank" rel="noopener noreferrer"><strong>Pak Cik Kopitiam · Sri Muar</strong><span>Taman Sri Tanjung · sarapan, kopi dan hidangan tempatan termasuk mee bandung.</span><em>Semak peta ↗</em></a>
            <a class="food-spot" href="https://www.google.com/maps/search/?api=1&query=Asam%20Pedas%20Jalan%20Joned%20Muar" target="_blank" rel="noopener noreferrer"><strong>Asam Pedas Jalan Joned</strong><span>Taman Sri Tanjung · pilihan asam pedas gaya Johor untuk makan tengah hari.</span><em>Semak peta ↗</em></a>
            <a class="food-spot" href="https://www.google.com/maps/search/?api=1&query=Bako-Bako%20%26%20Salai-Salai%20Haji%20Olie%20Muar" target="_blank" rel="noopener noreferrer"><strong>Bako-Bako &amp; Salai-Salai Haji Olie</strong><span>Jalan Bentayan · ikan bakar, lauk salai dan rasa Melayu/Johor.</span><em>Semak peta ↗</em></a>
          </div>
          <p class="food-note">Pilihan di atas berada di sekitar bandar Muar / Taman Sri Tanjung. Premis, menu dan waktu operasi boleh berubah; semak peta sebelum bergerak.</p>
        </div>
      </section>

      <section class="section" id="sekitar">
        <div class="shell">
          <span class="section-kicker">Tempat berdekatan</span>
          <h2 class="heading">Sambung berjalan ke sisi lain Bandar Maharani.</h2>
          <p class="lead">Tanjung Emas mudah digabungkan dengan mercu tanda dan seni bandar Muar. Susun laluan yang bergerak dari tepi sungai ke pusat bandar supaya tidak perlu berulang-alik.</p>
          <div class="nearby-grid">
            <article class="nearby-card"><span class="tag">Seni bina</span><h3>Masjid Jamek Sultan Ibrahim</h3><p>Mercu tanda di kawasan sungai yang sesuai digabungkan dengan lawatan ke Tanjung Emas. Hormati waktu ibadah, pakaian dan ruang jemaah.</p></article>
            <article class="nearby-card"><span class="tag">Bandar</span><h3>Menara Jam Muar</h3><p>Mercu tanda pusat Bandar Maharani dan titik yang mudah disertakan dalam pusingan singkat melalui bandar lama Muar.</p></article>
            <article class="nearby-card"><span class="tag">Seni jalanan</span><h3>Maharani Mural Lane & Cultural Walk</h3><p>Lorong dan dinding mural yang membawa cerita visual Muar — paling sesuai dilihat ketika masih terang untuk fotografi.</p></article>
            <article class="nearby-card"><span class="tag">Sungai</span><h3>Sultan Ismail Bridge & tebing bandar</h3><p>Gunakan jambatan dan kawasan tebing sebagai sambungan visual kepada pengalaman Sungai Muar sebelum kembali ke pusat bandar.</p></article>
          </div>
        </div>
      </section>

      <section class="section" id="faq">
