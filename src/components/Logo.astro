---
interface Props {
  compact?: boolean;
  light?: boolean;
  href?: string;
}
const { compact = false, light = false, href = '#atas' } = Astro.props;
---
<a href={href} class="brand" aria-label="Tanjung Emas Muar — kembali ke atas">
  <svg class="brand-mark" viewBox="0 0 180 180" role="img" aria-hidden="true">
    <rect width="180" height="180" rx="42" fill={light ? '#F3EFD9' : '#0E2E3B'} />
    <circle cx="90" cy="70" r="35" fill="#E8AC54" />
    <path d="M0 108c24-9 45-11 70 2 27 14 49 2 72-6 14-5 26-4 38-1v77H0z" fill={light ? '#0E2E3B' : '#E5E0CD'} />
    <path d="M0 133c24-9 45-11 71 3 28 15 50 3 72-6 14-5 25-4 37-1v51H0z" fill="#427E81" />
  </svg>
  {!compact && (
    <span class:list={["brand-type", light && "brand-type--light"]}>
      <strong>Tanjung Emas</strong>
      <small>Muar · Johor</small>
    </span>
  )}
</a>
