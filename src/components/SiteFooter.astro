---
import Logo from './Logo.astro';
import { links, place } from '../data/market';
import { locales, localeMeta, localePath, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { topicIds, topicSlug, topics } from '../content/topics';

interface Props {
  locale: Locale;
  slug?: string;
}
const { locale, slug = '' } = Astro.props;
const t = ui[locale];
const home = localePath(locale);
const prefix = slug ? home : '';
const addressText = `${place.streetAddress}, ${place.postalCode} ${place.addressLocality}, ${place.addressRegion}, Malaysia`;
const footerNav = [
  { label: t.nav.plan, href: `${prefix}#rancang` },
  { label: t.nav.transport, href: `${prefix}#pengangkutan` },
  { label: t.nav.food, href: `${prefix}#makan` },
  { label: t.nav.nearby, href: `${prefix}#sekitar` },
  { label: t.nav.faq, href: `${prefix}#faq` },
];
---
<footer class="footer">
  <div class="shell">
    <div class="footer-top">
      <div>
        <Logo light href={home} />
        <h2>{t.footerTagline}</h2>
      </div>
      <nav class="footer-nav" aria-label="Navigasi footer">
        {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
        {topicIds.map((id) => <a href={localePath(locale, topicSlug[id])}>{topics[id][locale].card.title}</a>)}
      </nav>
    </div>
    <div class="footer-bottom">
      <p>{t.addressLabel}: <a href={links.maps} target="_blank" rel="noopener noreferrer">{addressText}</a></p>
      <p>{t.footerDisclaimer}</p>
      <p>{t.footerLocale}</p>
    </div>
    <div class="footer-bottom">
      <div class="source-links">
        <a href={links.official} target="_blank" rel="noopener noreferrer">{t.sources.official}</a>
        <a href={links.bmj} target="_blank" rel="noopener noreferrer">{t.sources.bmj}</a>
        <a href={links.commons} target="_blank" rel="noopener noreferrer">{t.sources.commons}</a>
        <a href={links.maps} target="_blank" rel="noopener noreferrer">{t.sources.maps}</a>
      </div>
      <div class="source-links" aria-label={t.langSwitchAria}>
        {locales.map((code) => (
          <a href={localePath(code, slug)} hreflang={localeMeta[code].hreflang} lang={localeMeta[code].htmlLang}>{localeMeta[code].label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
