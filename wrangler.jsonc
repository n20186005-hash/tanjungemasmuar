{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanjungemasmuar",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "src/worker.js"
}
